# GadScape rev 241 launch settings, sourced by start.sh (copied to /opt/gadscape/start.env by setup.sh).

# The rev 241 cache (from the gadconv tool). start.sh refuses to start without it.
GADSCAPE_CACHE_DIR=/opt/gadscape/cache241

# Login RSA private key matching the modulus patched into the 241 client (PEM, or worlds.yml-style
# rsaPrivateExponent/rsaModulus lines). If the file is missing, worlds.yml's rsaPrivateExponent/rsaModulus are used.
GADSCAPE_RSA_PRIVATE=/opt/gadscape/keys/private.key

# The launcher's session token (jav_config param 9, the launcher's --session). Empty = not checked;
# set it once every player uses the GadScape launcher, so other clients get "bad session id".
GADSCAPE_LOGIN_TOKEN=

# Extra ports besides the world's port from worlds.yml. 443 = the client's fallback when 43594 is blocked.
GADSCAPE_EXTRA_PORTS=443

# Game (and, separately, JS5) connections allowed per IP address (rsprot default 10).
GADSCAPE_MAX_CONNECTIONS_PER_IP=10
